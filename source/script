local ESPStorage = {}

local function CreateBox()
    local lines = {}
    for i = 1, 4 do
        local line = Drawing.new("Line")
        line.Visible      = false
        line.Color        = Config.EnemyColor
        line.Thickness    = Config.BoxThickness
        line.Transparency = Config.BoxTransparency
        line.ZIndex       = 5
        lines[i] = line
    end

    local fill = Drawing.new("Square")
    fill.Visible      = false
    fill.Color        = Config.FillColor
    fill.Transparency = Config.FillTransparency
    fill.Thickness    = 0
    fill.Filled       = true
    fill.ZIndex       = 4

    lines.fill = fill
    return lines
end

local function RemoveESP(player)
    local data = ESPStorage[player]
    if not data then return end

    for i = 1, 4 do
        if data[i] then data[i]:Remove() end
    end
    if data.fill then data.fill:Remove() end

    ESPStorage[player] = nil
end

local function AddESP(player)
    if player == LocalPlayer and not Config.ShowSelf then return end
    if not ESPStorage[player] then
        ESPStorage[player] = CreateBox()
    end
end

local function GetBoundingBox(character)
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not rootPart or not humanoid then return nil end

    local rootPos    = rootPart.Position
    local charHeight = 5.5
    local halfW      = 1.4
    local bottomY    = rootPos.Y - (charHeight * 0.52)
    local topY       = rootPos.Y + (charHeight * 0.48)

    local corners3D = {
        Vector3.new(rootPos.X - halfW, bottomY, rootPos.Z - halfW),
        Vector3.new(rootPos.X + halfW, bottomY, rootPos.Z - halfW),
        Vector3.new(rootPos.X + halfW, bottomY, rootPos.Z + halfW),
        Vector3.new(rootPos.X - halfW, bottomY, rootPos.Z + halfW),
        Vector3.new(rootPos.X - halfW, topY,    rootPos.Z - halfW),
        Vector3.new(rootPos.X + halfW, topY,    rootPos.Z - halfW),
        Vector3.new(rootPos.X + halfW, topY,    rootPos.Z + halfW),
        Vector3.new(rootPos.X - halfW, topY,    rootPos.Z + halfW),
    }

    local minX, minY =  math.huge,  math.huge
    local maxX, maxY = -math.huge, -math.huge

    for _, corner in ipairs(corners3D) do
        local screenPos, visible = Camera:WorldToViewportPoint(corner)
        if not visible then return nil end
        if screenPos.X < minX then minX = screenPos.X end
        if screenPos.Y < minY then minY = screenPos.Y end
        if screenPos.X > maxX then maxX = screenPos.X end
        if screenPos.Y > maxY then maxY = screenPos.Y end
    end

    return minX, minY, maxX, maxY
end

local function DrawBox(lines, minX, minY, maxX, maxY)
    local TL = Vector2.new(minX, minY)
    local TR = Vector2.new(maxX, minY)
    local BL = Vector2.new(minX, maxY)
    local BR = Vector2.new(maxX, maxY)
    lines[1].From = TL; lines[1].To = TR
    lines[2].From = BL; lines[2].To = BR
    lines[3].From = TL; lines[3].To = BL
    lines[4].From = TR; lines[4].To = BR
    for i = 1, 4 do lines[i].Visible = true end
end

local function DrawFill(lines, minX, minY, maxX, maxY)
    if lines.fill then
        lines.fill.Position = Vector2.new(minX, minY)
        lines.fill.Size     = Vector2.new(maxX - minX, maxY - minY)
        lines.fill.Visible  = true
    end
end

local function HideBox(lines)
    for i = 1, 4 do lines[i].Visible = false end
    if lines.fill then lines.fill.Visible = false end
end

local function HideFill(lines)
    if lines.fill then lines.fill.Visible = false end
end

RunService.RenderStepped:Connect(function()
    if not Config.Enabled then
        for _, lines in pairs(ESPStorage) do HideBox(lines) end
        return
    end

    for player, lines in pairs(ESPStorage) do
        if not player or not player.Parent then
            RemoveESP(player)
        else
            local isSelf = (player == LocalPlayer)

            if isSelf and not Config.ShowSelf then
                HideBox(lines)
            else
                local sameTeam = (not isSelf)
                    and LocalPlayer.Team ~= nil
                    and player.Team ~= nil
                    and LocalPlayer.Team == player.Team

                local shouldShow = isSelf or (not sameTeam or Config.ShowTeammates)

                if not shouldShow then
                    HideBox(lines)
                else
                    local character = player.Character
                    local humanoid  = character and character:FindFirstChildOfClass("Humanoid")
                    if not character or not humanoid or humanoid.Health <= 0 then
                        HideBox(lines)
                    else
                        local outlineCol, fillCol
                        if Config.VisibleDetection and IsVisible(character) then
                            outlineCol = Config.VisibleColor
                            fillCol    = Config.VisibleFillColor
                        else
                            outlineCol = ResolveBoxColor(player)
                            fillCol    = ResolveFillColor(player)
                        end

                        for i = 1, 4 do
                            lines[i].Color        = outlineCol
                            lines[i].Transparency = Config.BoxTransparency
                            lines[i].Thickness    = Config.BoxThickness
                        end

                        if lines.fill then
                            lines.fill.Color        = fillCol
                            lines.fill.Transparency = Config.FillTransparency
                        end

                        local minX, minY, maxX, maxY = GetBoundingBox(character)
                        if minX then
                            DrawBox(lines, minX, minY, maxX, maxY)
                            if Config.FillEnabled then
                                DrawFill(lines, minX, minY, maxX, maxY)
                            else
                                HideFill(lines)
                            end
                        else
                            HideBox(lines)
                        end
                    end
                end
            end
        end
    end
end)

