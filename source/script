local MM2_PLACE_ID   = 142823291
local MM2_GunColor   = Color3.fromRGB(0, 120, 255)
local MM2_KnifeColor = Color3.fromRGB(255, 0, 0)

local function GetMM2RoleColor(player)
    local backpack  = player:FindFirstChild("Backpack")
    local character = player.Character

    local function hasToolNamed(name)
        if backpack  and backpack:FindFirstChild(name)  then return true end
        if character and character:FindFirstChild(name) then return true end
        return false
    end

    if hasToolNamed("Gun")   then return MM2_GunColor   end
    if hasToolNamed("Knife") then return MM2_KnifeColor end
    return nil
end

local function ResolveBoxColor(player)
    if Config.UseTeamColors then
        if game.PlaceId == MM2_PLACE_ID then
            local roleColor = GetMM2RoleColor(player)
            if roleColor then return roleColor end
        elseif player.Team then
            return player.TeamColor.Color
        end
    end
    return Config.EnemyColor
end

local function ResolveFillColor(player)
    if Config.UseTeamColors then
        if game.PlaceId == MM2_PLACE_ID then
            local roleColor = GetMM2RoleColor(player)
            if roleColor then return roleColor end
        elseif player.Team then
            return player.TeamColor.Color
        end
    end
    return Config.FillColor
end

local VisibilityCache            = {}
local VISIBILITY_CHECK_INTERVAL  = 0.02

local RAYCAST_OFFSETS = {
    Vector3.new(0,    2.5, 0),
    Vector3.new(0,    0,   0), 
    Vector3.new(0,   -2.0, 0),  
    Vector3.new( 0.8,  1.0, 0),
    Vector3.new(-0.8,  1.0, 0), 
}

local function IsVisible(character)
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end

    local now    = tick()
    local cached = VisibilityCache[character]
    if cached and (now - cached.time) < VISIBILITY_CHECK_INTERVAL then
        return cached.result
    end

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local ignoreList = { character, Camera }
    if LocalPlayer.Character then
        table.insert(ignoreList, LocalPlayer.Character)
    end
    rayParams.FilterDescendantsInstances = ignoreList

    local origin = Camera.CFrame.Position

    for _, offset in ipairs(RAYCAST_OFFSETS) do
        local target    = rootPart.Position + offset
        local direction = target - origin
        local result    = workspace:Raycast(origin, direction, rayParams)
        if result == nil then
            VisibilityCache[character] = { result = true, time = now }
            return true
        end
    end

    VisibilityCache[character] = { result = false, time = now }
    return false
end

Players.PlayerRemoving:Connect(function(player)
