local function HSVtoRGB(h, s, v)
    local i = math.floor(h * 6)
    local f = h * 6 - i
    local p = v * (1 - s)
    local q = v * (1 - f * s)
    local t = v * (1 - (1 - f) * s)
    i = i % 6
    if     i == 0 then return v, t, p
    elseif i == 1 then return q, v, p
    elseif i == 2 then return p, v, t
    elseif i == 3 then return p, q, v
    elseif i == 4 then return t, p, v
    elseif i == 5 then return v, p, q
    end
end

local function RGBtoHSV(r, g, b)
    r, g, b = r / 255, g / 255, b / 255
    local max, min = math.max(r, g, b), math.min(r, g, b)
    local h, s, v = 0, 0, max
    local d = max - min
    if max ~= 0 then s = d / max end
    if max ~= min then
        if     max == r then h = (g - b) / d + (g < b and 6 or 0)
        elseif max == g then h = (b - r) / d + 2
        elseif max == b then h = (r - g) / d + 4
        end
        h = h / 6
    end
    return h, s, v
end

-- Outline
local R, G, B      = 255, 0, 0
local H, S, V      = 0, 1, 1
local syncOutline  = false

-- Fill
local FR, FG, FB   = 255, 0, 0
local FH, FS, FV   = 0, 1, 1
local syncFill     = false

-- Visible outline
local VR, VG, VB   = 0, 255, 0
local VH, VS, VV   = 0.33, 1, 1
local syncVis      = false

-- Visible fill
local VFR, VFG, VFB = 0, 255, 0
local VFH, VFS, VFV = 0.33, 1, 1
local syncVisFill   = false

local function ApplyOutlineColor()   Config.EnemyColor      = Color3.fromRGB(R, G, B)         end
local function ApplyFillColor()      Config.FillColor       = Color3.fromRGB(FR, FG, FB)      end
local function ApplyVisibleColor()   Config.VisibleColor    = Color3.fromRGB(VR, VG, VB)      end
local function ApplyVisibleFill()    Config.VisibleFillColor= Color3.fromRGB(VFR, VFG, VFB)  end

local function OnOutlineHSV()
    if syncOutline then return end
    syncOutline = true
    local r, g, b = HSVtoRGB(H, S, V)
    R, G, B = math.floor(r*255), math.floor(g*255), math.floor(b*255)
    syncOutline = false
    ApplyOutlineColor()
end
local function OnOutlineRGB()
    if syncOutline then return end
    syncOutline = true
    H, S, V = RGBtoHSV(R, G, B)
    syncOutline = false
    ApplyOutlineColor()
end

local function OnFillHSV()
    if syncFill then return end
    syncFill = true
    local r, g, b = HSVtoRGB(FH, FS, FV)
    FR, FG, FB = math.floor(r*255), math.floor(g*255), math.floor(b*255)
    syncFill = false
    ApplyFillColor()
end
local function OnFillRGB()
    if syncFill then return end
    syncFill = true
    FH, FS, FV = RGBtoHSV(FR, FG, FB)
    syncFill = false
    ApplyFillColor()
end

local function OnVisHSV()
    if syncVis then return end
    syncVis = true
    local r, g, b = HSVtoRGB(VH, VS, VV)
    VR, VG, VB = math.floor(r*255), math.floor(g*255), math.floor(b*255)
    syncVis = false
    ApplyVisibleColor()
end
local function OnVisRGB()
    if syncVis then return end
    syncVis = true
    VH, VS, VV = RGBtoHSV(VR, VG, VB)
    syncVis = false
    ApplyVisibleColor()
end

local function OnVisFillHSV()
    if syncVisFill then return end
    syncVisFill = true
    local r, g, b = HSVtoRGB(VFH, VFS, VFV)
    VFR, VFG, VFB = math.floor(r*255), math.floor(g*255), math.floor(b*255)
    syncVisFill = false
    ApplyVisibleFill()
end
local function OnVisFillRGB()
    if syncVisFill then return end
    syncVisFill = true
    VFH, VFS, VFV = RGBtoHSV(VFR, VFG, VFB)
    syncVisFill = false
    ApplyVisibleFill()
end

ApplyOutlineColor()
ApplyFillColor()
ApplyVisibleColor()
ApplyVisibleFill()

